{
    "openapi": "3.0.0",
    "info": {
        "title": "EventJunction API",
        "description": "Native and imported workspace events",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Current EventJunction server"
        }
    ],
    "paths": {
        "/api/v1/events": {
            "get": {
                "summary": "List native and imported workspace events",
                "operationId": "7f33096a817e7236930659cbf660accb",
                "parameters": [
                    {
                        "name": "source",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "eventnest",
                                "humanitix",
                                "google_calendar",
                                "ics",
                                "csv",
                                "wordpress",
                                "eventbrite"
                            ]
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "draft",
                                "published",
                                "cancelled"
                            ]
                        }
                    },
                    {
                        "name": "starts_after",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "starts_before",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 25,
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated events",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CanonicalEvent"
                                            }
                                        },
                                        "meta": {
                                            "type": "object"
                                        },
                                        "links": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication required"
                    },
                    "403": {
                        "description": "Read permission and workspace membership required"
                    },
                    "422": {
                        "description": "Invalid filters"
                    },
                    "429": {
                        "description": "Rate limit exceeded"
                    }
                },
                "security": [
                    {
                        "apiKey": []
                    }
                ]
            }
        },
        "/api/events": {
            "get": {
                "summary": "Legacy template-grouped event listing",
                "operationId": "90fe1c0b0cd23e4cf375c9229468c779",
                "responses": {
                    "200": {
                        "description": "Legacy event response"
                    }
                },
                "security": [
                    {
                        "apiKey": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "CanonicalEvent": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "starts_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "ends_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "timezone": {
                        "type": "string",
                        "nullable": true
                    },
                    "location": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "draft",
                            "published",
                            "cancelled"
                        ]
                    },
                    "source": {
                        "properties": {
                            "provider": {
                                "type": "string",
                                "enum": [
                                    "eventnest",
                                    "humanitix",
                                    "google_calendar",
                                    "ics",
                                    "csv",
                                    "wordpress",
                                    "eventbrite"
                                ]
                            },
                            "external_id": {
                                "type": "string",
                                "nullable": true
                            },
                            "url": {
                                "type": "string",
                                "nullable": true
                            }
                        },
                        "type": "object"
                    },
                    "custom_fields": {
                        "type": "object"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "apiKey": {
                "type": "http",
                "bearerFormat": "Sanctum token",
                "scheme": "bearer"
            }
        }
    }
}